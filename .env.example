# Gen - AI Router Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI
GEN_OPENAI_KEY=

# Groq
GEN_GROQ_KEY=

# Together
GEN_TOGETHER_KEY=

# OpenRouter
GEN_OPENROUTER_KEY=

# Google Gemini
GEN_GEMINI_KEY=

# Disable providers (set to 1 to disable)
# GEN_OPENAI_DISABLE=1
# GEN_GROQ_DISABLE=1
# GEN_TOGETHER_DISABLE=1
# GEN_OPENROUTER_DISABLE=1
# GEN_GEMINI_DISABLE=1